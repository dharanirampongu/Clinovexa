# Clinovexa frontend environment variables.
# Copy to `.env` for local development or set in your hosting dashboard for production.
#
# Monorepo production (frontend + backend on one Vercel project):
#   leave this empty/unset -> the app calls relative `/api` (rewritten to serverless `api/index.js`).
#
# Frontend-only hosting (backend deployed separately, e.g. Render/Railway/Fly):
#   set this to the backend origin, WITHOUT a trailing slash:
#   VITE_API_BASE_URL=https://your-backend-domain.com/api
#
# Do NOT point this at the frontend domain itself, or `/api/auth/register` will 404.
# Do NOT hardcode localhost here for production.
# VITE_API_BASE_URL=
